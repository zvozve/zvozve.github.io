{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Hexo: 清理并生成静态页面",
      "type": "shell",
      "command": "python .tools/blog.py build",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Hexo: 部署到 master 分支",
      "type": "shell",
      "command": "python .tools/blog.py deploy",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Git: 提交源码到 hexo 分支",
      "type": "shell",
      "command": "python .tools/blog.py commit",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "一键: 备份源码 + 发布新页面",
      "type": "shell",
      "command": "python .tools/blog.py publish",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Front-matter: 检查补全 (--check)",
      "type": "shell",
      "command": "python .tools/blog.py check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Hexo: 本地预览",
      "type": "shell",
      "command": "python .tools/blog.py preview",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
